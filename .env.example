# ============ DeepSeek AI 配置 ============
# 用于 AI 采购顾问对话、扫描润色等功能
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ============ PostgreSQL 数据库配置 ============
# 标准端口为 5432，根据实际环境修改
PG_HOST=127.0.0.1
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=
PG_DB=zhilian_crawl_db

# ============ 后端服务配置 ============
# FastAPI 服务监听地址和端口
