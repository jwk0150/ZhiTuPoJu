# ============ DeepSeek AI 配置 ============
# 用于 AI 采购顾问对话、扫描润色等功能
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ============ PostgreSQL 数据库配置 ============
# 本机开发（经 SSH 隧道）：127.0.0.1:5433 → 云库 5432
# ECS 上 Docker：compose 会覆盖为 host.docker.internal:5432
PG_HOST=127.0.0.1
PG_PORT=5433
PG_USER=postgres
PG_PASSWORD=
PG_DB=zhitu_crawl_db
# 数字人才地图岗位表（云库 map_data_table，约 3.8 万条）
PG_JOB_TABLE=map_data_table

# ============ JWT ============
JWT_SECRET=change-me-in-production
JWT_TTL=604800

# ============ 后端服务配置 ============
# FastAPI 服务监听地址和端口
BACKEND_HOST=127.0.0.1
BACKEND_PORT=5000

# ============ 表名前缀配置 ============
# 不同数据源使用不同前缀：zhilian_、boss_、lagou_ 等
TABLE_PREFIX=zhilian_
