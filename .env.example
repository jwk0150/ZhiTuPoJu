# ============ DeepSeek AI 配置 ============
# 用于 AI 采购顾问对话、扫描润色等功能
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ============ RAG Embedding / VectorStore 配置 ============
# 本地中文向量模型（首次使用会从 HuggingFace 下载，约 95MB）
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DIM=512
EMBEDDING_VERSION=bge-small-zh-v1.5@v1
EMBEDDING_DEVICE=cpu
# 向量存储实现：array（默认，double precision[] + numpy，免安装）| pgvector（未来安装后切换）
VECTOR_STORE=array

# ============ Hybrid Retrieval 配置 ============
# 融合权重：final = vector×w_v + keyword×w_k + metadata×w_m
HYBRID_WEIGHT_VECTOR=0.5
HYBRID_WEIGHT_KEYWORD=0.3
HYBRID_WEIGHT_METADATA=0.0
# 最低相关度阈值：低于此分返回 INSUFFICIENT_EVIDENCE
HYBRID_MIN_SCORE=0.22

# ============ PostgreSQL 数据库配置 ============
# 标准端口为 5432，根据实际环境修改
PG_HOST=127.0.0.1
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=
PG_DB=zhilian_crawl_db

# ============ 后端服务配置 ============
# FastAPI 服务监听地址和端口
BACKEND_HOST=127.0.0.1
BACKEND_PORT=5000

# ============ 表名前缀配置 ============
# 不同数据源使用不同前缀：zhilian_、boss_、lagou_ 等
TABLE_PREFIX=zhilian_
